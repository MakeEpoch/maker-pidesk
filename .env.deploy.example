# Copy to .env.deploy.local (Git-ignored) and run: chmod 600 .env.deploy.local
PIDESK_DEPLOY_HOST=pi@your-pi.local
PIDESK_DEPLOY_PORT=22
PIDESK_DEPLOY_KNOWN_HOSTS=var/deploy-known-hosts
# Optional existing SSH key; empty uses normal SSH agent/default identities.
PIDESK_DEPLOY_KEY=
# Passwords are optional; key-based/interactive SSH continues to work without them.
PIDESK_DEPLOY_PASSWORD=
# Omit this to use the SSH password for sudo; override if needed.
# PIDESK_DEPLOY_SUDO_PASSWORD=
